rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Rooms collection
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Swap codes collection
    match /swap_codes/{codeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Swap logs collection
    match /swap_logs/{logId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
