rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection (shared between Kelompokin & QuizIn)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Rooms collection (Kelompokin)
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Swap codes collection (Kelompokin)
    match /swap_codes/{codeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Swap logs collection (Kelompokin)
    match /swap_logs/{logId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Quizzes collection (QuizIn)
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Quiz submissions collection (QuizIn)
    match /quiz_submissions/{submissionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
